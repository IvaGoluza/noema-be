# Anthropic — used for reframing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=200
ANTHROPIC_TIMEOUT_S=30
ANTHROPIC_MAX_RETRIES=3

# Google Cloud Translation v2 — used for HR → EN
GOOGLE_TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT_S=5

# Model paths (relative to the repo root)
MODEL_BINARY_PATH=./models/binary_detector
MODEL_TYPE_PATH=./models/category_classifier

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_USER_TEXT=false      # never log full user text in production
